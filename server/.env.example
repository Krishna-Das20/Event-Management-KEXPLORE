# Copy to server/.env and fill in your own values.
# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/encore?retryWrites=true&w=majority
# Long random string used to sign session cookies:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
# Google Cloud Console → Google Auth Platform → Clients → Web client ID
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
# Comma-separated list of front-end origins allowed to call the API cross-site
CLIENT_URL=http://localhost:5173
API_PORT=5000
# Set to "false" to stop the API from auto-seeding demo events into an empty database
SEED_ON_EMPTY=true
